{
  "name": "vibii",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "demo:audio": "bash scripts/make-demo-audio.sh",
    "worker": "tsx --env-file=.env.local worker/index.ts",
    "test": "vitest run --configLoader runner",
    "test:e2e": "playwright test",
    "dev:webpack": "WATCHPACK_POLLING=true next dev --webpack",
    "catalog:build": "tsx scripts/build-catalog.ts",
    "agent:smoke": "tsx --env-file=.env.local scripts/agent-smoke.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "music-metadata": "11.12.0",
    "next": "16.4.2",
    "pg": "8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.1",
    "@types/pg": "8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "4.20.6",
    "typescript": "^5",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=20.9"
  }
}
