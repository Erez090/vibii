# ---- Database (required) -------------------------------------------------------------
# Local:    postgres:///vibii_dev
# Supabase: Project Settings → Database → Connection string (use the pooler URI for Vercel)
DATABASE_URL=postgres:///vibii_dev

# ---- Supabase Auth + private Storage (required for real multi-user mode) -------------
# Without these, a clearly labelled isolated local demo login is offered (never in production).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for private Storage uploads/signing and auth.admin.deleteUser on account deletion.
SUPABASE_SERVICE_ROLE_KEY=
VIBII_STORAGE_BUCKET=vibii-private

# ---- App secrets ---------------------------------------------------------------------
# 32+ random characters. Signs local media URLs and hashes identities for one-time grants.
VIBII_SECRET=replace-with-32-plus-random-characters
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated emails that are granted the admin role on sign-in (server-managed).
VIBII_ADMIN_EMAILS=
# Bearer secret for GET /api/worker/tick (Vercel Cron or another scheduler).
CRON_SECRET=

# ---- Optional ------------------------------------------------------------------------
# Set to "off" to hide local demo login even in development.
VIBII_LOCAL_DEMO_AUTH=
# Hosts the worker may download PERMITTED provider files from (comma-separated, https only).
VIBII_DOWNLOAD_HOSTS=
# Optional LLM brief adapter (not enabled by default; personal data is never sent without consent).
ANTHROPIC_API_KEY=
VIBII_LLM_BRIEFS=off
DATABASE_POOL_MAX=5
